{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3BucketLifecycle",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:GetBucketTagging",
        "s3:PutBucketTagging",
        "s3:DeleteBucketTagging",
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketPublicAccessBlock",
        "s3:DeleteBucketPublicAccessBlock",
        "s3:GetBucketCORS",
        "s3:PutBucketCORS",
        "s3:DeleteBucketCORS"
      ],
      "Resource": [
        "arn:aws:s3:::healthcare-photos-dev",
        "arn:aws:s3:::healthcare-photos-prod",
        "arn:aws:s3:::healthcare-dev-progress-photos-621770702801",
        "arn:aws:s3:::healthcare-prod-progress-photos-621770702801"
      ]
    },
    {
      "Sid": "S3ObjectLifecycle",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::healthcare-photos-dev/*",
        "arn:aws:s3:::healthcare-photos-prod/*",
        "arn:aws:s3:::healthcare-dev-progress-photos-621770702801/*",
        "arn:aws:s3:::healthcare-prod-progress-photos-621770702801/*"
      ]
    },
    {
      "Sid": "IamManagedPolicyLifecycle",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": [
        "arn:aws:iam::621770702801:policy/healthcare-dev-progress-photo-bucket-access",
        "arn:aws:iam::621770702801:policy/healthcare-prod-progress-photo-bucket-access"
      ]
    },
    {
      "Sid": "IamRoleLifecycle",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PassRole",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::621770702801:role/healthcare-dev-ec2-role",
        "arn:aws:iam::621770702801:role/healthcare-prod-*"
      ]
    },
    {
      "Sid": "IamInstanceProfileLifecycle",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:UntagInstanceProfile",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": [
        "arn:aws:iam::621770702801:instance-profile/healthcare-dev-ec2-profile",
        "arn:aws:iam::621770702801:instance-profile/healthcare-prod-*"
      ]
    }
  ]
}

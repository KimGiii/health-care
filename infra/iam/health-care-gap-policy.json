{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SsmParameterStoreHealthcareScope",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParameterHistory",
        "ssm:DeleteParameter",
        "ssm:LabelParameterVersion",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource",
        "ssm:ListTagsForResource"
      ],
      "Resource": "arn:aws:ssm:ap-northeast-2:621770702801:parameter/healthcare/*"
    },
    {
      "Sid": "SsmDescribeParametersRequiresWildcard",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeParameters"
      ],
      "Resource": "*"
    },
    {
      "Sid": "KmsForSsmSecureString",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.ap-northeast-2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "CostExplorerReadOnly",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage",
        "ce:GetCostForecast",
        "ce:GetDimensionValues",
        "ce:GetTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IamSelfInspection",
      "Effect": "Allow",
      "Action": [
        "iam:ListAttachedUserPolicies",
        "iam:ListUserPolicies",
        "iam:GetUserPolicy",
        "iam:GetUser"
      ],
      "Resource": "arn:aws:iam::621770702801:user/health-care-prod"
    },
    {
      "Sid": "IamPolicyDocumentRead",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions"
      ],
      "Resource": "arn:aws:iam::621770702801:policy/*"
    },
    {
      "Sid": "IamDevRoleTeardown",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRolePolicy",
        "iam:DeleteRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": "arn:aws:iam::621770702801:role/healthcare-dev-*"
    },
    {
      "Sid": "RdsSnapshotLifecycle",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBSnapshot",
        "rds:DescribeDBSnapshots",
        "rds:DeleteDBSnapshot",
        "rds:AddTagsToResource",
        "rds:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:rds:ap-northeast-2:621770702801:db:healthcare-*",
        "arn:aws:rds:ap-northeast-2:621770702801:snapshot:healthcare-*"
      ]
    },
    {
      "Sid": "InventoryReadOnly",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3BucketVersionInspection",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::healthcare-*"
    },
    {
      "Sid": "EcrImageInspection",
      "Effect": "Allow",
      "Action": [
        "ecr:ListImages",
        "ecr:DescribeImages"
      ],
      "Resource": "arn:aws:ecr:ap-northeast-2:621770702801:repository/healthcare-*"
    }
  ]
}
